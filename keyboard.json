{
    "manufacturer": "Lakshya Rao",
    "keyboard_name": "macropad",
    "maintainer": "Lakshya Rao",

    "processor": "RP2040",
    "board": "GENERIC_RP_RP2040",
    "bootloader": "rp2040",

    "features": {
        "bootmagic": true,
        "mousekey": true,
        "nkro": true,
        "extrakey": true,
        "rgblight": true,
        "raw": true
    },

    "matrix_pins": {
        "direct": [
            ["GP27", "GP14", "GP6"],
            ["GP15", "GP9", "GP5"],
            ["GP26", "GP8", "GP4"]
        ]
    },

    "debounce": 5,

    "ws2812": {
        "pin": "GP13",
        "driver": "vendor"
    },

    "rgblight": {
        "animations": {
            "alternating": true,
            "breathing": true,
            "christmas": true,
            "knight": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "rgb_test": true,
            "snake": true,
            "static_gradient": true,
            "twinkle": true
        },
        "hue_steps": 32,
        "led_count": 3
    },

    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },

    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}